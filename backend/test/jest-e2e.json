{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "globalSetup": "<rootDir>/test/support/create-database.ts",
  "setupFiles": ["<rootDir>/test/support/setup-env.ts"],
  "testTimeout": 30000,
  "maxWorkers": 1
}
